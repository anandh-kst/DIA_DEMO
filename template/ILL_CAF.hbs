<body>

  <div class="container">
    <div class="page">
      <div class="po">
        <div class="main-content">
          <div class="main-heading">
            <h1>{{companyDetails.soTitle}}</h1>
          </div>
          <div class="top-address-details">
            <div class="flex-po">
              <div class="col-md-7 address">
                <p class="sub-heading">To</p>
                <ul>
                  <li class="sub-heading">
                    SIFY TECHNOLOGIES LIMITED, </li>
                  <li>
                    2nd floor Tidel Park,
                  </li>
                  <li>
                    NO.4 Rajiv Gandhi Salai,
                  </li>
                  <li>
                    Taramani,Chennai-600113.
                  </li>
                </ul>
              </div>
              <div class="col-md-4 po-details">
                <p class="sub-heading">PO Date : <span>{{#if poDate}} {{poDate}} {{else}} {{now "date"}}
                    {{/if}}</span> </p>
                <p class="sub-heading">PO Number : <span>{{#if poRefNo}} {{poRefNo}} {{else}} ILL-{{reqId}}
                    {{/if}}</span></p>
              </div>
            </div>
          </div>
          <div class="main-heading2 top-address2">
            <p class="customer-name">This Document is Shared by {{cpCompany}} ({{customerName}}) and Accound Manager :
              {{accountManagerName}}</p>
          </div>

          <div class="main-heading2">
            <h1>Dedicated Internet Access New Connection(s) </h1>
          </div>
          <!-- ******** TABLE ********* -->
          <div class="table sify-service">
            <table class="table table-bordered" style="width:100%">
              {{!-- <colgroup>
                <col width="3%" />
                <col width="30%" />
                <col width="25%" />
                <col width="30%" />
                <col width="10%" />
                <col width="10%" />
              </colgroup> --}}
              <thead>
                <tr>
                  <th scope="col">
                    <span>S.No</span>
                  </th>
                  {{!-- <th scope="col">
                    <span>Company</span>
                  </th> --}}
                  <th scope="col">
                    <span>Customer Shipping Address</span>
                  </th>
                  <th scope="col">
                    <span>Product</span>
                  </th>
                  <th scope="col" style="text-align: right">
                    <span>One Time Charges (OTC)</span>
                  </th>
                  <th scope="col">
                    <span>Annual Recurring Charges (ARC)</span>
                  </th>
                </tr>
              </thead>
              {{#each locationDetails}}
              <tbody>
                <!-- ************************************************* Sify Technologies Ltd ************************************************* -->
                {{#each basePlan}}
                <tr>
                  <td class="border-top-bottom">{{incSerial1}}</td>
                  {{!-- <td class="border-top-bottom">Sify Technologies Limited</td> --}}
                  <td class="border-none" style="vertical-align: middle;">
                    <ul>
                      <li>{{../shippingAddress.address1}},</li>
                      <li>{{../shippingAddress.address2}},</li>
                      {{#if ../shippingAddress.address3}}
                      <li>{{../shippingAddress.address3}},</li>
                      {{/if}}
                      <li>{{../shippingAddress.city}}, {{../shippingAddress.state}} - {{../shippingAddress.pincode}}.
                      </li>
                    </ul>
                  </td>
                  <td>
                    <ul>
                      <li>{{../connectionType}}: {{../reqBandwidth}} {{../reqBandwidthUOM}}</li>
                      <li>Class of Service: {{planType}}</li>
                      <li>Contract Term: {{../contractPeriod}} {{../contractUnit}}</li>
                    </ul>
                  </td>
                  <td style="text-align: right;">{{#if otc}} ₹ {{otc}} {{else}} - {{/if}}</td>
                  <td style="text-align: right;">{{#if arc}} ₹ {{arc}} {{else}} - {{/if}}</td>
                </tr>
                {{/each}}
                <!-- ************************************************* TOWER CHARGES ************************************************* -->
                {{#each additionalPrice}}
                <tr>
                  <td class="border-top-bottom"></td>
                  {{!-- <td class="border-right border-top-bottom"></td> --}}
                  <td class="border-none"></td>
                  <td>{{mastHeight}} Meter {{mastType}} (provided by Sify)</td>
                  <td style="text-align: right;">{{#if otc}} ₹ {{otc}} {{else}} - {{/if}}</td>
                  <td style="text-align: right;">{{#if arc}} ₹ {{arc}} {{else}} - {{/if}}</td>
                </tr>
                {{/each}}
                {{#each valueAddedService}}
                <tr>
                  <td class="border-top-bottom"></td>
                  {{!-- <td class="border-right border-top-bottom"></td> --}}
                  <td class="border-none"></td>
                  <td>{{name}}</td>
                  <td style="text-align: right;">{{#if otc}} ₹ {{otc}} {{else}} - {{/if}}</td>
                  <td style="text-align: right;">{{#if arc}} ₹ {{arc}} {{else}} - {{/if}}</td>
                </tr>
                {{/each}}
                <!-- ********************************************* Sify Digital Services *********************************** -->
                {{!-- {{#if ../hasManaged}}
                <tr>
                  <td rowspan="3" style="border-top: 1pt solid #ddd !important;">{{incSerial}}</td>
                  <td rowspan="3" style="border-top: 1pt solid #ddd !important;">Sify Digital Services Limited</td>
                  <td rowspan="3" class="border-none"></td>
                  {{#each managedBundled}}
                </tr>
                <tr>
                  <td>{{name}}</td>
                  <td class="text-right"> {{#if otc}}₹ {{otc}} {{else}} - {{/if}}</td>
                  <td class="text-right"> {{#if arc}}₹ {{arc}} {{else}} - {{/if}}</td>
                </tr>
                {{/each}}
                {{/if}} --}}
              </tbody>
              {{/each}}
              <tr class="sub-heading">
                <td style="vertical-align: middle;text-align: end;" colspan="3">Total</td>
                <td style="vertical-align: middle;text-align: end;">{{#if stlPrice.otc}}₹&nbsp;{{stlPrice.otc}} {{else}}
                  -
                  {{/if}}
                </td>
                <td style="vertical-align: middle;text-align: end;">{{#if stlPrice.arc}}₹&nbsp;{{stlPrice.arc}} {{else}}
                  -
                  {{/if}}
                </td>
              </tr>
            </table>
            {{#if hasRateCard}}
            <div>
              <p>
                <b>Terms and Conditions</b>
                applicable as per the
                {{companyDetails.soDes}}
                signed between SIFY TECHNOLOGIES LIMITED &
                {{companyName}}.
              </p>
            </div>
            {{/if}}
            <div class="po-signature">
              <p style="font-size: 10pt; font-weight: 600; margin-bottom: 9pt; margin-top: 9pt;">{{companyName}}</p>
              <p style="font-size: 8pt; font-weight: 600; margin-bottom: 50pt;">Signature: <span
                  style="color: white;">/sn1/</span></p>
            </div>
          </div>
        </div>
      </div>


      {{#if hasManaged}}
      <div class="col-md-7 address" style="page-break-before: always; margin-top:50px">
        <p class="sub-heading">To</p>
        <ul>
          <li class="sub-heading">
            SIFY DIGITAL SERVICES LIMITED, </li>
          <li>
            2nd floor Tidel Park,
          </li>
          <li>
            NO.4 Rajiv Gandhi Salai,
          </li>
          <li>
            Taramani,Chennai-600113.
          </li>
        </ul>
      </div>
      <div class="table sify-service" style="margin-top:30px">
        <table class="table table-bordered" style="width:100%">
          {{!-- <colgroup>
            <col width="3%" />
            <col width="30%" />
            <col width="25%" />
            <col width="30%" />
            <col width="10%" />
            <col width="10%" />
          </colgroup> --}}
          <thead>
            <tr>
              <th scope="col">
                <span>S.No</span>
              </th>
              {{!-- <th scope="col">
                <span>Company</span>
              </th> --}}
              <th scope="col">
                <span>Customer Shipping Address</span>
              </th>
              <th scope="col">
                <span>Product</span>
              </th>
              <th scope="col" style="vertical-align: middle;text-align: end;">
                <span>One Time Charges (OTC)</span>
              </th>
              <th scope="col">
                <span>Annual Recurring Charges (ARC)</span>
              </th>
            </tr>
          </thead>
          {{#each locationDetails}}
          <tbody>
            {{#if hasManaged}}
            <tr>
              <td rowspan="3" style="border-top: 1pt solid #ddd !important;">{{incSerial2}}</td>
              {{!-- <td rowspan="3" style="border-top: 1pt solid #ddd !important;">Sify Digital Services Limited</td>
              --}}
              <td rowspan="3" class="border-none" style="vertical-align: middle;">
                <ul>
                  <li>{{shippingAddress.address1}},</li>
                  <li>{{shippingAddress.address2}},</li>
                  {{#if shippingAddress.address3}}
                  <li>{{shippingAddress.address3}},</li>
                  {{/if}}
                  <li>{{shippingAddress.city}}, {{shippingAddress.state}} - {{shippingAddress.pincode}}.
                  </li>
                </ul>
              </td>
            </tr>
            {{#each managedBundled}}
            <tr>
              <td>{{name}}</td>
              <td class="text-right"> {{#if otc}}₹ {{otc}} {{else}} - {{/if}}</td>
              <td class="text-right"> {{#if arc}}₹ {{arc}} {{else}} - {{/if}}</td>
            </tr>
            {{/each}}
            {{/if}}
          </tbody>
          {{/each}}
