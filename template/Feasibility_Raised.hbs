<!DOCTYPE html>
<html>

<head>
  <title>Master Template</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>

  <style>
    html {
      -webkit-print-color-adjust: exact;
    }

    .container {
      /* height: 842pt !important; */
      width: 595pt !important;
      /* to centre page on screen*/
      margin-left: auto;
      margin-right: auto;
    }

    .link {
      color: #3b80ff;
      cursor: pointer;
    }

    .text-right {
      text-align: right;
    }

    hr {
      background-color: #d1e06d;
      height: 1.2px;
    }

    .button-details {
      margin-bottom: 26px;
    }

    p {
      margin-bottom: 16px;
    }

    .table-heading {
      color: #0E3346;
      font-size: 11pt;
      font-weight: 600;
    }

    .greeting {
      margin-bottom: 26px;
    }

    .primary {
      color: #0E3346;
    }

    .button {
      background-color: #0E3346;
      border: none;
      border-radius: 5px;
      font-family: arial;
      color: #fff;
      padding: 10px 32px;
      text-align: center;
      text-decoration: none;
      display: inline-block;
      font-size: 10pt;
      cursor: pointer;
    }

    .button:hover {
      color: #fff !important;
      text-decoration: none;
    }

    body {
      font-size: 10pt;
    }

    .flex-po {
      display: flex;
      justify-content: space-between !important;
    }

    body ul {
      list-style: none;
      padding: 0pt;
      margin-bottom: 0pt;
      line-height: 1.8;

    }

    .list-style {
      margin-left: 22px;

    }

    body ol {
      padding: 0pt;
      margin-bottom: 0pt;
      margin-left: 9pt;
      line-height: 15pt;
    }

    body ol span {
      color: #0045AC;
      cursor: poi;
    }

    .flex {
      display: flex;

    }

    .justify-between {
      justify-content: space-between;
    }

    .flex2 {
      display: flex;
      justify-content: space-between;
    }

    .logo {
      text-align: right;
      margin-bottom: 26px;
    }

    .text-right {
      text-align: right;
    }

    .logo svg {
      width: 55pt;
    }

    .vl {
      border-left: 1pt solid #CBD0D2;
      height: auto;
    }

    .main-heading {
      margin-bottom: 30pt;
    }

    .main-heading h1 {
      color: #0E3346;
      text-align: center;
      font-size: 18pt;
      font-weight: 600;
      margin: 0pt;
    }

    .main-heading2 h1 {
      color: #0E3346;
      font-size: 10pt;
      font-weight: 600;
      margin-bottom: 0pt;
    }

    .main-heading2 {
      margin-bottom: 8pt;
    }

    .sub-heading {
      color: #0E3346;
      font-style: normal;
      font-weight: 600;
      line-height: normal;
      margin-bottom: 6px;
    }

    .sub-heading2 h1 {
      color: #0E3346;
      font-style: normal;
      font-weight: 600;
      line-height: normal;
      font-size: 10pt;

    }

    .address {
      padding: 0pt;
      margin-bottom: 26px;
    }

    .contact {
      border-radius: 6pt;
      background: #F7F9FA;
      padding: 12pt 20pt;
    }

    .contact svg {
      margin-bottom: -3pt;
    }

    .main-content {
      padding: 33pt;
    }

    /* ************** TABLE ************ */
    .table-bordered {
      margin-bottom: 10px !important;
    }

    .table {
      margin-bottom: 10px !important;
    }

    table,
    th,
    td {
      border: 1pt solid black;
      border-collapse: collapse;
    }

    table tr th {
      background: rgba(14, 51, 70, 0.70) !important;
      color: #fff;
    }

    thead tr th {
      padding: 14pt 6pt !important;
    }

    tbody tr td {
      padding: 14pt 6pt !important;
    }

    .table-2 thead tr th {
      padding: 14pt 7pt !important;
    }

    .table-2 tbody tr td {
      padding: 14pt 5pt !important;
    }

    /* ************** TABLE ************ */

    .bottom-address {
      background: #F7F9FA;
      padding: 20pt;
      margin-bottom: 50px;
    }

    .bottom-content {
      background: #F7F9FA;
      padding: 16pt;
    }

    .sub-text h1 {
      color: var(--black-1, #1E2122);
      font-size: 8pt;
      font-style: normal;
      font-weight: 600;
      line-height: normal;
      margin: 0pt;
      margin-top: 6pt;
    }

    .Date-time {
      margin-top: 30pt;
    }

    .Date-time .name {
      margin-bottom: 10px;
    }

    .Date-time p {
      margin-bottom: 4pt;
    }


    .sify-service table tbody tr td:nth-child(9) {
      text-align: right !important;
    }

    .sify-service table tbody tr td:nth-child(10) {
      text-align: right !important;
    }


    .sify-service table thead tr th:nth-child(9) {
      text-align: right !important;
    }

    .sify-service table thead tr th:nth-child(10) {
      text-align: right !important;
    }


    .sign {
      margin-bottom: 60pt;
    }

    .footer {
      bottom: 0pt !important;
      width: 100%;
    }

    .container {
      position: relative;
    }

    .company-name h1 {
      font-size: 12px;
      font-weight: 500;
    }

    .company-name {
      margin-top: 55px;
    }

    .company-name p {
      font-weight: 600;

    }

    .date-text {
      font-weight: 400;
    }

    .top-address2 {
      margin-top: 40px;
    }

    .mb-10 {
      margin-bottom: 10px !important;
    }

    .mb-0 {
      margin-bottom: 0px !important;
    }
  </style>
</head>

<body style="display:block; clear:both; page-break-after:always;">
  <!-- ***************** PAGE 1 ************************************************** -->
  <div class="container">

    <div class="main-content">

      <div class="top-header">
        <div class="logo">
          <svg width="55" height="29" viewBox="0 0 55 29" fill="none" xmlns="http://www.w3.org/2000/svg">
