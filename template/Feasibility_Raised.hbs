              <clipPath id="clip0_205_25">
                <rect width="55" height="29" fill="white" />
              </clipPath>
            </defs>
          </svg>
        </div>
      </div>
      <div class="top-address-details">
        <div>
          <p>
            Dear {{customerName}},
          </p>
          <div class="greeting">
            <p class="sub-heading">Greetings from Sify!</p>
            <p>
              At the outset, we would like to thank you for your continued business with Sify.

              Thanks for raising feasibility with One Sify for DIA Services. The link wise feasibility
              details are shared below.
            </p>
          </div>
        </div>
      </div>
      <div class="top-address-details">
        <div class="flex-po">
          <div class="address">
            {{!-- <p class="sub-heading">Your company profile details are shared below.</p> --}}
            <ul class="list-style">
              <li>Request Date: {{now "date"}}</li>
              <li>Request ID: {{reqId}}</li>
              <li>Request Type: {{quoteType}}</li>
            </ul>
          </div>
        </div>
      </div>
      {{!-- <div class="button-details">
        <p class="mb-10">Please click the'{{Button Name}}' button or this link <span class="link">{{Link}}</span> to
          complete your account
          activation</p>
        <div>
          <a href="link" class="button">Button Name</a>
        </div>
      </div> --}}


      {{!-- <p class="mb-10">If the email content has a table in it, the following table format to be followed.</p> --}}
      {{!-- <p class="table-heading">Title of table if available</p> --}}
      <!-- ******** TABLE ********* -->
      <div class="table sify-service">
        <table class="table table-bordered" style="width:100%; border-collapse: collapse;" border="1" cellpadding="0"
          cellspacing="0">

          <colgroup>
            <col width="10%">
            <col width="20%">
            <col width="20%">
            <col width="20%">
            <col width="20%">


          </colgroup>
          <thead>
            <tr>
              <th scope="col" bgcolor="#0E3346" style="background-color: #0E3346; color: #ffffff; padding: 14pt 6pt;">
                <span style="color: #ffffff;">Sl.No</span>
              </th>
              <th scope="col" bgcolor="#0E3346" style="background-color: #0E3346; color: #ffffff; padding: 14pt 6pt;">
                <span style="color: #ffffff;">Feasibility ID</span>
              </th>

              {{#if isNew}} {{else}}<th scope="col" bgcolor="#0E3346"
                style="background-color: #0E3346; color: #ffffff; padding: 14pt 6pt;">
                <span style="color: #ffffff;">Link ID</span>
              </th>
              {{/if}}
              <th scope="col" bgcolor="#0E3346" style="background-color: #0E3346; color: #ffffff; padding: 14pt 6pt;">
                <span style="color: #ffffff;">Location</span>
              </th>
              <th scope="col" bgcolor="#0E3346" style="background-color: #0E3346; color: #ffffff; padding: 14pt 6pt;">
                <span style="color: #ffffff;">Connection Type</span>
              </th>
              <th scope="col" bgcolor="#0E3346" style="background-color: #0E3346; color: #ffffff; padding: 14pt 6pt;">
                <span style="color: #ffffff;">Bandwidth</span>
              </th>
              <th scope="col" bgcolor="#0E3346" style="background-color: #0E3346; color: #ffffff; padding: 14pt 6pt;">
                <span style="color: #ffffff;">Feasibility Status</span>
              </th>

            </tr>
          </thead>
          <tbody>
            {{#each locationDetails}}
            <tr>
              <td>{{add @index 1}}</td>
              <td>{{this.feasibilityId}}</td>
              {{#unless ../isNew}}
              <td>{{this.existingPlanDetails.linkId}}</td>
              {{/unless}}
              <td>{{shippingAddress.city}}</td>
              <td>{{connectionType}}</td>
              <td>{{reqBandwidth}} {{reqBandwidthUOM}}</td>
              <td>{{feasibilityStatus}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        <div>
          <p>We will do the feasibility study at the earliest and revert with an update within 7 working days.</p>
          <p>While we share the feasibility update by email, you may parallelly access One Sify Portal
            <a href="{{url}}">{{url}}</a> to check the link wise statuses and generate proposal.
          </p>
        </div>
        <div>
          <p>We look forward for your business.</p>
          <p>For any queries, please feel free to contact your Customer Experience Manager {{customerName}}, @
            {{customerNumber}} or write to us @ onesify@sifycorp.com</p>
        </div>
        <div class="Date-time">
          <div class="name">
            <p>Best Regards</p>
            <p>Team One Sify</p>
          </div>
        </div>
        <hr>
        <div class="bottom-add">
          <table width="100%" cellpadding="0" cellspacing="0" border="0"
            style="border: none; border-collapse: collapse;">
            <tr>
              <!-- Left Column - Address -->
              <td width="60%" align="left" valign="top" style="vertical-align: top; padding: 0; border: none;">
                <div style="margin: 0;">
                  <p style="margin: 0 0 5px 0; font-weight: bold; color: #0E3346; font-size: 11pt;">Sify Technologies
                  </p>
                  <ul style="margin: 0; padding: 0; list-style: none; color: #000000;">
                    <li style="margin: 0; padding: 0; font-size: 10pt;">Il Floor, TIDEL Park, No.4,</li>
                    <li style="margin: 0; padding: 0; font-size: 10pt;">Rajiv Gandhi Salai, Taramani,</li>
                    <li style="margin: 0; padding: 0; font-size: 10pt;">Chennai - 600113</li>
                  </ul>
                </div>
              </td>

              <!-- Right Column - Links -->
              <td width="40%" align="right" valign="top" style="vertical-align: top; padding: 0; border: none;">
                <ul style="text-align: right; margin: 0; padding: 0; list-style: none;">
                  <li style="margin: 0 0 5px 0; padding: 0;">
                    <a href="" style="color: #3b80ff; text-decoration: none; font-size: 10pt;">Terms & Conditions</a>
                  </li>
                  <li style="margin: 0 0 5px 0; padding: 0;">
                    <a href="" style="color: #3b80ff; text-decoration: none; font-size: 10pt;">Privacy Policy</a>
                  </li>
                  <li style="margin: 0; padding: 0;">
                    <a href="" style="color: #3b80ff; text-decoration: none; font-size: 10pt;">Legal</a>
                  </li>
                </ul>
              </td>
            </tr>
          </table>
      </div>
      <!-- ******** TABLE ********* -->

    </div>
    <div class="bottom-content footer">
      <div class="flex2">
